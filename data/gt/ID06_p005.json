[
 {
  "type": "text",
  "text": "B. PDB Menurut Pengeluaran",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; src=Heading",
  "text_level": 2
 },
 {
  "type": "text",
  "text": "1. Pertumbuhan Ekonomi Tahun 2025 Terhadap 2024 (C-to-C)",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; src=Heading; C-to-C miring",
  "text_level": 3
 },
 {
  "type": "text",
  "text": "Ekonomi Indonesia tahun 2025 tumbuh sebesar 5,11 persen (c-to-c). Pertumbuhan terjadi pada seluruh komponen pengeluaran. Pertumbuhan tertinggi dicapai oleh Komponen Ekspor Barang dan Jasa sebesar 7,03 persen; diikuti Komponen Pengeluaran Konsumsi LNPRT (PK-LNPRT) sebesar 5,13 persen; Komponen Pembentukan Modal Tetap Bruto (PMTB) sebesar 5,09 persen; Komponen Pengeluaran Konsumsi Rumah Tangga (PK-RT) sebesar 4,98 persen; dan Komponen Pengeluaran Konsumsi Pemerintah (PK-P) sebesar 2,50 persen. Komponen Impor Barang dan Jasa (yang merupakan faktor pengurang dalam PDB menurut Pengeluaran) tumbuh sebesar 4,77 persen.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; c-to-c miring"
 },
 {
  "type": "image",
  "img_path": null,
  "image_caption": "Gambar 4 Pertumbuhan PDB Beberapa Komponen Pengeluaran (C-to-C) (persen), 2023–2025",
