 {
  "type": "text",
  "text": "Pasal 22",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; src=Pasal",
  "text_level": 5
 },
 {
  "type": "text",
  "text": "Peraturan Menteri ini mulai berlaku pada tanggal diundangkan.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14"
 },
 {
  "type": "text",
  "text": "Agar setiap orang mengetahuinya, memerintahkan pengundangan Peraturan Menteri ini dengan penempatannya dalam Berita Negara Republik Indonesia.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14"
 },
 {
  "type": "text",
  "text": "Ditetapkan di Jakarta pada tanggal 21 Desember 2017",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; blok penetapan; 2 baris digabung; spasi ganda diringkas"
 },
 {
  "type": "text",
  "text": "MENTERI KEUANGAN REPUBLIK INDONESIA,",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; jabatan penandatangan; 2 baris digabung"
 },
 {
  "type": "text",
  "text": "ttd.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14"
 },
 {
  "type": "text",
  "text": "SRI MULYANI INDRAWATI",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; nama penandatangan"
 },
 {
  "type": "text",
  "text": "Diundangkan di Jakarta pada tanggal 22 Desember 2017",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; blok pengundangan; 2 baris digabung; spasi ganda diringkas"
 },
 {
  "type": "text",
  "text": "DIREKTUR JENDERAL PERATURAN PERUNDANG-UNDANGAN KEMENTERIAN HUKUM DAN HAK ASASI MANUSIA REPUBLIK INDONESIA,",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; jabatan; 4 baris digabung"
 },
 {
  "type": "text",
  "text": "ttd.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14"
 },
 {
  "type": "text",
  "text": "WIDODO EKATJAHJANA",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; nama"
 },
 {
  "type": "text",
  "text": "BERITA NEGARA REPUBLIK INDONESIA TAHUN 2017 NOMOR 1885",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; spasi lebar diringkas"
 },
 {
  "type": "text",
  "text": "Salinan sesuai dengan aslinya",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; blok pengesahan salinan"
 },
 {
  "type": "text",
  "text": "Kepala Biro Umum u.b. Kepala Bagian TU Kementerian",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; 3 baris digabung; sebagian tertimpa stempel"
 },
