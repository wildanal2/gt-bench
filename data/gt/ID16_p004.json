  "gt_note": "verif:AB:2026-11-14; kalimat pengantar daftar"
 },
 {
  "type": "text",
  "text": "a. penerbitan Sertifikat Elektronik;",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; butir daftar"
 },
 {
  "type": "text",
  "text": "b. penerapan Tanda Tangan Elektronik; dan",
  "page_idx": 0,
  "bbox": null,
