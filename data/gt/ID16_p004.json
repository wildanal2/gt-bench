  "gt_note": "verif:AB:2026-11-14; butir daftar"
 },
 {
  "type": "text",
  "text": "c. pemantauan dan evaluasi.",
  "page_idx": 0,
  "bbox": null,
  "in_figure": false,
  "gt_note": "verif:AB:2026-11-14; butir daftar"
 },
 {
  "type": "text",
